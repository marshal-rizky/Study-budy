# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Which provider the director talks to: anthropic | openai-compat | fake
TEACHER_PROVIDER=fake
# Model id for that provider, e.g. claude-fable-5, llama-3.3-70b-versatile
TEACHER_MODEL=
# Base URL, only for openai-compat (Groq, Cerebras, OpenRouter, Ollama, LM Studio)
TEACHER_BASE_URL=
# The key for the chosen provider
TEACHER_API_KEY=

# Convenience: per-provider keys picked up when TEACHER_API_KEY is unset.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY_1=
